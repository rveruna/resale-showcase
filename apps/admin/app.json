{
  "expo": {
    "name": "Resale Admin",
    "slug": "resale-admin",
    "scheme": "resale",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [["expo-router", { "asyncRoutes": { "web": false } }]],
    "experiments": {
      "reactCompiler": true
    }
  }
}
